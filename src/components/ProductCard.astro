---
interface Props { index: string; category: string; description: string; }
const { index, category, description } = Astro.props;
---
<article class="solution-card">
	<div class="solution-card__top"><span class="solution-card__index">{index}</span></div>
	<div class="solution-card__body"><h3>{category}</h3><p>{description}</p></div>
	<a class="text-link" href="#contact" data-enquiry={category}>Make an enquiry <span aria-hidden="true">&rarr;</span></a>
</article>