---
import SiteLayout from '../layouts/SiteLayout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProductCard from '../components/ProductCard.astro';
import SiteFooter from '../components/SiteFooter.astro';

const solutions = [
	{ index: '01', category: 'Pharmaceuticals', description: 'Quality pharmaceutical products for institutional and healthcare requirements.' },
	{ index: '02', category: 'Surgical Supplies', description: 'Surgical products and essential healthcare supplies for hospitals and medical institutions.' },
	{ index: '03', category: 'Dental Equipment & Materials', description: 'Equipment, materials and supplies supporting dental care and clinical requirements.' },
	{ index: '04', category: 'Laboratory Chemicals & Reagents', description: 'Laboratory chemicals, reagents and related supplies supporting testing requirements.' },
	{ index: '05', category: 'Diagnostic Kits & Equipment', description: 'Diagnostic kits and equipment supporting healthcare testing and diagnostic requirements.' },
];

const principles = [
	{ index: '01', title: 'Quality-focused supply', text: 'Careful attention to product quality across healthcare supply requirements.' },
	{ index: '02', title: 'Broad product expertise', text: 'Five supply areas spanning pharmaceutical, surgical, dental, laboratory and diagnostic needs.' },
	{ index: '03', title: 'Institutional capability', text: 'Current supply experience with government hospitals and colleges.' },
	{ index: '04', title: 'Professional service', text: 'Responsive communication and a long-term approach to supply relationships.' },
];
---

<SiteLayout
	title="Dhanvin Pharmaceuticals | Pharmaceutical & Healthcare Supply"
	description="Dhanvin Pharmaceuticals supplies healthcare products to government hospitals and colleges, with expertise in pharmaceuticals, surgical supplies, dental, laboratory and diagnostic equipment."
>
	<Navbar />
	<main id="main-content">
		<Hero />
		<section class="intro-strip" aria-label="Company overview">
			<div class="container intro-strip__inner">
				<p><span class="status-dot" aria-hidden="true"></span> Established in 2024</p>
				<p>Current supply to government hospitals and colleges</p>
				<a href="#about">Get to know us <span aria-hidden="true">&rarr;</span></a>
			</div>
		</section>

		<section class="section section--about" id="about">
			<div class="container about-grid">
				<div class="about-aside">
					<p class="eyebrow">A dependable partner</p>
					<p class="about-aside__year">2024</p>
					<p class="about-aside__caption">Established in Andhra Pradesh</p>
					<div class="about-aside__rule" aria-hidden="true"></div>
					<p class="about-aside__note">Healthcare supply, approached with care.</p>
				</div>
				<div class="about-copy">
					<SectionHeading eyebrow="About Dhanvin" title="Supply that supports better care." />
					<p class="body-copy">Established in 2024, Dhanvin Pharmaceuticals is an India-based pharmaceutical and healthcare supply company serving institutional requirements across a focused range of medical supply areas.</p>
					<p class="body-copy">Its work is guided by a quality-focused approach, responsive coordination and professional service.</p>
					<a class="text-link" href="#contact">Start a conversation <span aria-hidden="true">&rarr;</span></a>
				</div>
			</div>
		</section>

		<section class="section section--solutions" id="solutions">
			<div class="container">
				<div class="section-heading-row">
					<SectionHeading eyebrow="Our Expertise" title="Comprehensive Healthcare & Medical Supply Solutions" text="Five supply areas supporting the product requirements of healthcare providers and institutions." />
					<a class="text-link section-heading-row__link" href="#contact">Discuss your requirements <span aria-hidden="true">&rarr;</span></a>
				</div>
				<div class="solutions-grid">
					{solutions.map((solution) => <ProductCard {...solution} />)}
				</div>
			</div>
		</section>

		<section class="institutional" id="institutional">
			<div class="container institutional__inner">
				<div class="institutional__mark" aria-hidden="true">
					<span class="institutional__mark-line"></span>
					<span class="institutional__mark-text">CURRENT<br />SUPPLY</span>
					<span class="institutional__mark-line"></span>
				</div>
				<div class="institutional__copy">
					<p class="eyebrow eyebrow--light">Current business</p>
					<h2>Serving Government Healthcare Institutions</h2>
					<p>Dhanvin Pharmaceuticals supplies healthcare products, medicines and surgical supplies to government hospitals and colleges, supporting their healthcare and institutional requirements with a quality-focused approach.</p>
					<div class="institutional__tags" aria-label="Our approach">
						<span>Government hospitals</span><span>Government colleges</span><span>Healthcare supply</span>
					</div>
				</div>
				<a class="button button--light" href="#contact">Discuss your requirements <span aria-hidden="true">&rarr;</span></a>
			</div>
		</section>

		<section class="section section--principles" id="why-dhanvin">
			<div class="container">
				<div class="principles-heading">
					<SectionHeading eyebrow="Why Dhanvin" title="A partner for the work behind care." text="Professional supply relationships are built on the details: listening, communication and follow-through." />
				</div>
				<div class="principles-grid">
					{principles.map((principle) => (
						<article class="principle">
							<span class="principle__index">{principle.index}</span>
							<h3>{principle.title}</h3>
							<p>{principle.text}</p>
						</article>
					))}
				</div>
			</div>
		</section>

		<section class="vision" id="vision">
			<div class="vision__grid" aria-hidden="true"></div>
			<div class="container vision__inner">
				<div class="vision__content">
					<p class="eyebrow eyebrow--light">Future direction</p>
					<h2>From regional supply to global healthcare partnerships.</h2>
					<p class="vision__current"><strong>Today:</strong> Focused on healthcare supply to government hospitals and colleges.</p>
					<p class="vision__future"><strong>Looking ahead:</strong> Dhanvin Pharmaceuticals aims to build international healthcare partnerships and explore future import and export opportunities.</p>
					<a class="button button--mint" href="#contact">Build what comes next <span aria-hidden="true">&rarr;</span></a>
				</div>
				<div class="vision-map" aria-hidden="true">
					<div class="vision-map__rings"></div>
					<span class="vision-map__node vision-map__node--one"></span><span class="vision-map__node vision-map__node--two"></span>
					<span class="vision-map__node vision-map__node--three"></span><span class="vision-map__node vision-map__node--four"></span>
					<span class="vision-map__label vision-map__label--one">ANDHRA PRADESH</span><span class="vision-map__label vision-map__label--two">FUTURE NETWORK</span>
				</div>
			</div>
			<div class="container vision__footnote"><span>01</span><span>Ambition for the future. Focused on today's commitments.</span></div>
		</section>

		<section class="section section--contact" id="contact">
			<div class="container contact-grid">
				<div class="contact-copy">
					<SectionHeading eyebrow="Contact us" title="Let's talk about your requirements." text="Connect with our team for institutional procurement, product enquiries and supply discussions." />
					<div class="contact-actions">
						<a class="contact-action" href="tel:+916303037997"><span class="contact-action__label">Phone</span><span class="contact-action__value">6303037997</span></a>
						<a class="contact-action" href="mailto:dhanvinpharmaceuticals@gmail.com"><span class="contact-action__label">Email</span><span class="contact-action__value">dhanvinpharmaceuticals@gmail.com</span></a>
						<a class="contact-action contact-action--whatsapp" href="https://wa.me/916303037997?text=Hello%20Dhanvin%20Pharmaceuticals%2C%20I%20would%20like%20to%20make%20a%20business%20enquiry." target="_blank" rel="noreferrer"><span class="contact-action__label">WhatsApp enquiry</span><span class="contact-action__value">Message our team <span aria-hidden="true">&nearr;</span></span></a>
					</div>
					<div class="offices">
						<div class="office"><h3>Head Office</h3><address>6-135, Vattigudipadu Village,<br />Agiripalli Mandal, Eluru District,<br />Andhra Pradesh 521211, India</address></div>
						<div class="office"><h3>Branch Office</h3><address>Turlapati Kutumbarao Street,<br />Labbipet, Vijayawada 520008,<br />Andhra Pradesh, India</address></div>
					</div>
				</div>
				<div class="enquiry-panel">
					<div class="enquiry-panel__top"><p class="eyebrow">Business enquiries</p><p class="enquiry-panel__number">01 <span>/ 01</span></p></div>
					<h3>Tell us what you need.</h3>
					<p class="enquiry-panel__intro">Share a few details and your email app will open with your enquiry ready to send.</p>
					<form id="enquiry-form">
						<div class="form-row"><label for="name">Your name <span aria-hidden="true">*</span></label><input id="name" name="name" autocomplete="name" required /></div>
						<div class="form-row"><label for="email">Work email <span aria-hidden="true">*</span></label><input id="email" name="email" type="email" autocomplete="email" required /></div>
						<div class="form-row"><label for="organization">Organization</label><input id="organization" name="organization" autocomplete="organization" /></div>
						<div class="form-row">
							<label for="interest">Area of interest</label>
							<select id="interest" name="interest">
								<option value="General enquiry">Choose a category</option>
								{solutions.map((solution) => <option value={solution.category}>{solution.category}</option>)}
								<option value="Institutional supply">Institutional supply</option><option value="Other business enquiry">Other business enquiry</option>
							</select>
						</div>
						<div class="form-row"><label for="message">How can we help? <span aria-hidden="true">*</span></label><textarea id="message" name="message" rows="3" required></textarea></div>
						<button class="button button--primary form-submit" type="submit">Prepare email enquiry <span aria-hidden="true">&rarr;</span></button>
						<p class="form-status" id="form-status" aria-live="polite"></p>
					</form>
				</div>
			</div>
		</section>
	</main>
	<SiteFooter />
</SiteLayout>

<script>
	const form = document.querySelector<HTMLFormElement>('#enquiry-form');
	const status = document.querySelector<HTMLElement>('#form-status');

	form?.addEventListener('submit', (event) => {
		event.preventDefault();
		if (!form.reportValidity()) return;
		const data = new FormData(form);
		const subject = encodeURIComponent(`Business enquiry: ${data.get('interest')}`);
		const body = encodeURIComponent(`Name: ${data.get('name')}\nEmail: ${data.get('email')}\nOrganization: ${data.get('organization') || 'Not provided'}\nArea of interest: ${data.get('interest')}\n\n${data.get('message')}`);
		if (status) status.textContent = 'Opening your email app with the enquiry details. Please send the message there to complete your enquiry.';
		window.location.href = `mailto:dhanvinpharmaceuticals@gmail.com?subject=${subject}&body=${body}`;
	});

	document.querySelectorAll<HTMLAnchorElement>('[data-enquiry]').forEach((link) => {
		link.addEventListener('click', () => {
			const interest = document.querySelector<HTMLSelectElement>('#interest');
			if (interest) interest.value = link.dataset.enquiry ?? 'General enquiry';
		});
	});
</script>
