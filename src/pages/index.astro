---
import SiteLayout from '../layouts/SiteLayout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProductCard from '../components/ProductCard.astro';
import SiteFooter from '../components/SiteFooter.astro';

const solutions = [
	{ index: '01', category: 'Pharmaceuticals', description: 'Quality pharmaceutical products for institutional and healthcare requirements.' },
	{ index: '02', category: 'Surgical Supplies', description: 'Surgical products and essential healthcare supplies for institutional medical requirements.' },
	{ index: '03', category: 'Dental Equipment & Materials', description: 'Equipment, materials and supplies supporting dental care and clinical requirements.' },
	{ index: '04', category: 'Laboratory Chemicals & Reagents', description: 'Laboratory chemicals, reagents and related supplies supporting testing requirements.' },
	{ index: '05', category: 'Diagnostic Kits & Equipment', description: 'Diagnostic kits and equipment supporting healthcare testing and diagnostic requirements.' },
];

const activities = [
	{ index: '01', title: 'Supply of medicines to government hospitals', text: 'We supply medicines in response to institutional requirements, subject to applicable tender terms, product approvals and regulatory requirements.' },
	{ index: '02', title: 'Medical college supplies', text: 'We support the procurement needs of medical colleges and associated healthcare facilities for medicines and relevant healthcare products.' },
	{ index: '03', title: 'Government tender participation', text: 'We review tender requirements, prepare relevant documentation, coordinate product sourcing and work within applicable eligibility criteria and procurement conditions.' },
	{ index: '04', title: 'Institutional healthcare procurement', text: 'We aim to serve eligible institutional customers by understanding product specifications, quantities, delivery schedules and documentation needs.' },
];
---

<SiteLayout
	title="Dhanvin Pharmaceuticals | Pharmaceutical & Healthcare Supply"
	description="Pharmaceutical and healthcare supply expertise across pharmaceuticals, surgical supplies, dental, laboratory and diagnostic products."
>
	<Navbar />
	<main id="main-content">
		<Hero />
		<section class="intro-strip" aria-label="Company overview">
			<div class="container intro-strip__inner">
				<p><span class="status-dot" aria-hidden="true"></span> Established in 2024</p>
				<p>Pharmaceutical & healthcare supply</p>
				<a href="#about">Get to know us <span aria-hidden="true">&rarr;</span></a>
			</div>
		</section>

		<section class="section section--about" id="about">
			<div class="container about-grid">
				<div class="about-aside">
					<p class="eyebrow">A dependable partner</p>
					<p class="about-aside__year">2024</p>
					<p class="about-aside__caption">Established in Andhra Pradesh</p>
					<div class="about-aside__rule" aria-hidden="true"></div>
					<p class="about-aside__note">Healthcare supply, approached with care.</p>
				</div>
				<div class="about-copy">
					<SectionHeading eyebrow="Who we are" title="A dependable partner in healthcare supply." />
					<p class="body-copy">Established in 2024, Dhanvin Pharmaceuticals is an India-based pharmaceutical and healthcare supply company focused on meeting institutional procurement requirements.</p>
					<p class="body-copy">We supply medicines to government hospitals and medical colleges, and participate in government tender opportunities for medicines and healthcare-related products. Our work includes understanding specifications, documentation needs and supply conditions to support an organized, transparent procurement process.</p>
					<p class="body-copy">We value timely access to medicines and essential healthcare supplies. Through responsible sourcing, professional coordination and responsive service, we aim to build lasting relationships with public healthcare institutions.</p>
					<a class="text-link" href="#contact">Start a conversation <span aria-hidden="true">&rarr;</span></a>
				</div>
			</div>
		</section>

		<section class="section section--solutions" id="solutions">
			<div class="container">
				<div class="section-heading-row">
					<SectionHeading eyebrow="Our Expertise" title="Comprehensive Healthcare & Medical Supply Solutions" text="Five supply areas supporting the product requirements of healthcare providers and institutions." />
					<a class="text-link section-heading-row__link" href="#contact">Discuss your requirements <span aria-hidden="true">&rarr;</span></a>
				</div>
				<div class="solutions-grid">
					{solutions.map((solution) => <ProductCard {...solution} />)}
				</div>
			</div>
		</section>

		<section class="institutional" id="institutional">
			<div class="container institutional__inner">
				<div class="institutional__mark" aria-hidden="true">
					<span class="institutional__mark-line"></span>
					<span class="institutional__mark-text">CURRENT<br />SUPPLY</span>
					<span class="institutional__mark-line"></span>
				</div>
				<div class="institutional__copy">
					<p class="eyebrow eyebrow--light">Current business</p>
					<h2>Current Government Supply</h2>
					<p>Dhanvin Pharmaceuticals currently supplies quality medicines and surgical products to the Government of Andhra Pradesh. We understand the important role government hospitals and medical colleges play in serving communities, and aim to support public healthcare through responsible sourcing, attention to requirements and professional service.</p>
					<div class="institutional__tags" aria-label="Our approach">
						<span>Quality medicines</span><span>Surgical products</span>
					</div>
				</div>
				<a class="button button--light" href="#contact">Discuss your requirements <span aria-hidden="true">&rarr;</span></a>
			</div>
		</section>

		<section class="section section--activities" id="activities">
			<div class="container">
				<div class="activities-heading">
					<SectionHeading eyebrow="What we do" title="Our core business activities" text="We work to understand institutional needs and support procurement through dependable coordination and professional service." />
				</div>
				<div class="activities-grid">
					{activities.map((activity) => (
						<article class="activity">
							<span class="activity__index">{activity.index}</span>
							<h3>{activity.title}</h3>
							<p>{activity.text}</p>
						</article>
					))}
				</div>
			</div>
		</section>

		<section class="section section--purpose" id="purpose">
			<div class="container">
				<div class="purpose-heading">
					<SectionHeading eyebrow="Our purpose" title="Guided by service, integrity and partnership." />
				</div>
				<div class="purpose-pillars">
					<article class="purpose-pillar">
						<p class="eyebrow">Our mission</p>
						<p>To support public healthcare institutions through dependable medicine supply and professional procurement services. We strive to contribute to efficient institutional purchasing through responsible sourcing, clear communication and a commitment to agreed supply requirements.</p>
					</article>
					<article class="purpose-pillar">
						<p class="eyebrow">Our vision</p>
						<p>To establish Dhanvin Pharmaceuticals as a trusted partner for government hospitals, medical colleges and healthcare institutions through reliability, professional integrity and consistent service.</p>
					</article>
				</div>
				<h3 class="values-heading">Our values</h3>
				<div class="values-grid">
					<article class="value"><h4>Reliability</h4><p>Dependable coordination and fulfilling agreed supply commitments.</p></article>
					<article class="value"><h4>Quality and compliance</h4><p>Sourcing products that meet applicable specifications and regulatory requirements.</p></article>
					<article class="value"><h4>Transparency</h4><p>Clear communication and responsible business practices.</p></article>
					<article class="value"><h4>Customer commitment</h4><p>Understanding institutional requirements and providing suitable supply solutions.</p></article>
					<article class="value"><h4>Long-term partnerships</h4><p>Building trust, accountability and lasting relationships through service.</p></article>
				</div>
			</div>
		</section>

		<section class="vision" id="vision">
			<div class="vision__grid" aria-hidden="true"></div>
			<div class="container vision__inner">
				<div class="vision__content">
					<p class="eyebrow eyebrow--light">Future direction</p>
					<h2>From regional supply to global healthcare partnerships.</h2>
					<p class="vision__current"><strong>Today — Strengthening our foundation:</strong> We focus on pharmaceutical supply and institutional procurement, supported by responsible sourcing, professional coordination and dependable service.</p>
					<p class="vision__future"><strong>Tomorrow — Expanding across the world:</strong> Our long-term ambition is to explore international markets through pharmaceutical and healthcare product imports and exports. We aspire to build partnerships with manufacturers, suppliers, distributors and healthcare institutions across countries.</p>
					<p class="vision__global"><strong>Our global vision:</strong> To become a trusted international partner in pharmaceutical and healthcare supply, guided by quality-conscious sourcing, regulatory compliance, ethical business practices and dependable partnerships.</p>
					<p class="vision__global">We welcome opportunities to connect with international manufacturers, pharmaceutical exporters and importers, distributors and institutional buyers who share a vision for long-term business growth.</p>
					<a class="button button--mint" href="#contact">Build what comes next <span aria-hidden="true">&rarr;</span></a>
				</div>
				<div class="vision-map" aria-hidden="true">
					<div class="vision-map__rings"></div>
					<span class="vision-map__node vision-map__node--one"></span><span class="vision-map__node vision-map__node--two"></span>
					<span class="vision-map__node vision-map__node--three"></span><span class="vision-map__node vision-map__node--four"></span>
					<span class="vision-map__label vision-map__label--one">ANDHRA PRADESH</span><span class="vision-map__label vision-map__label--two">FUTURE NETWORK</span>
				</div>
			</div>
			<div class="container vision__footnote"><span>01</span><span>Ambition for the future. Focused on today's commitments.</span></div>
		</section>

		<section class="section section--contact" id="contact">
			<div class="container contact-grid">
				<div class="contact-copy">
					<SectionHeading eyebrow="Contact us" title="Let's talk about your requirements." text="Connect with our team for institutional procurement, product enquiries and supply discussions." />
					<div class="contact-actions">
						<a class="contact-action" href="tel:+916303037997"><span class="contact-action__label">Phone</span><span class="contact-action__value">6303037997</span></a>
						<a class="contact-action" href="mailto:dhanvinpharmaceuticals@gmail.com"><span class="contact-action__label">Email</span><span class="contact-action__value">dhanvinpharmaceuticals@gmail.com</span></a>
						<a class="contact-action contact-action--whatsapp" href="https://wa.me/916303037997?text=Hello%20Dhanvin%20Pharmaceuticals%2C%20I%20would%20like%20to%20make%20a%20business%20enquiry." target="_blank" rel="noreferrer"><span class="contact-action__label">WhatsApp enquiry</span><span class="contact-action__value">Message our team <span aria-hidden="true">&nearr;</span></span></a>
					</div>
					<div class="offices">
						<div class="office"><h3>Head Office</h3><address>6-135, Vattigudipadu Village,<br />Agiripalli Mandal, Eluru District,<br />Andhra Pradesh 521211, India</address></div>
						<div class="office"><h3>Corporate Office</h3><address>Turlapati Kutumbarao Street,<br />Labbipet, Vijayawada 520008,<br />Andhra Pradesh, India</address></div>
					</div>
				</div>
				<div class="enquiry-panel">
					<div class="enquiry-panel__top"><p class="eyebrow">Business enquiries</p><p class="enquiry-panel__number">01 <span>/ 01</span></p></div>
					<h3>Tell us what you need.</h3>
					<p class="enquiry-panel__intro">Share a few details and your email app will open with your enquiry ready to send.</p>
					<form id="enquiry-form">
						<div class="form-row"><label for="name">Your name <span aria-hidden="true">*</span></label><input id="name" name="name" autocomplete="name" required /></div>
						<div class="form-row"><label for="email">Work email <span aria-hidden="true">*</span></label><input id="email" name="email" type="email" autocomplete="email" required /></div>
						<div class="form-row"><label for="organization">Organization</label><input id="organization" name="organization" autocomplete="organization" /></div>
						<div class="form-row">
							<label for="interest">Area of interest</label>
							<select id="interest" name="interest">
								<option value="General enquiry">Choose a category</option>
								{solutions.map((solution) => <option value={solution.category}>{solution.category}</option>)}
								<option value="Institutional supply">Institutional supply</option><option value="Other business enquiry">Other business enquiry</option>
							</select>
						</div>
						<div class="form-row"><label for="message">How can we help? <span aria-hidden="true">*</span></label><textarea id="message" name="message" rows="3" required></textarea></div>
						<button class="button button--primary form-submit" type="submit">Prepare email enquiry <span aria-hidden="true">&rarr;</span></button>
						<p class="form-status" id="form-status" aria-live="polite"></p>
					</form>
				</div>
			</div>
		</section>
	</main>
	<SiteFooter />
</SiteLayout>

<script>
	const form = document.querySelector<HTMLFormElement>('#enquiry-form');
	const status = document.querySelector<HTMLElement>('#form-status');

	form?.addEventListener('submit', (event) => {
		event.preventDefault();
		if (!form.reportValidity()) return;
		const data = new FormData(form);
		const subject = encodeURIComponent(`Business enquiry: ${data.get('interest')}`);
		const body = encodeURIComponent(`Name: ${data.get('name')}\nEmail: ${data.get('email')}\nOrganization: ${data.get('organization') || 'Not provided'}\nArea of interest: ${data.get('interest')}\n\n${data.get('message')}`);
		if (status) status.textContent = 'Opening your email app with the enquiry details. Please send the message there to complete your enquiry.';
		window.location.href = `mailto:dhanvinpharmaceuticals@gmail.com?subject=${subject}&body=${body}`;
	});

	document.querySelectorAll<HTMLAnchorElement>('[data-enquiry]').forEach((link) => {
		link.addEventListener('click', () => {
			const interest = document.querySelector<HTMLSelectElement>('#interest');
			if (interest) interest.value = link.dataset.enquiry ?? 'General enquiry';
		});
	});
</script>
