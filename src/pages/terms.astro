---
import SiteLayout from '../layouts/SiteLayout.astro';
import Navbar from '../components/Navbar.astro';
import SiteFooter from '../components/SiteFooter.astro';
---
<SiteLayout title="Website Terms | Dhanvin Pharmaceuticals" description="Information about the scope and use of the Dhanvin Pharmaceuticals corporate website.">
	<Navbar />
	<main class="legal-page container" id="main-content">
		<p class="eyebrow">Website information</p>
		<h1>Website Terms</h1>
		<p>This website provides general information about Dhanvin Pharmaceuticals and its healthcare supply areas. It is not an online pharmacy, product catalogue, medical service or purchasing platform.</p>
		<h2>Enquiries and supply discussions</h2>
		<p>Submitting an enquiry does not confirm an order, product availability or a supply arrangement. Product requirements and any supply terms are discussed directly with the company.</p>
		<h2>Health information</h2>
		<p>Website content is not medical advice and should not be used to make treatment decisions. Contact a qualified healthcare professional for medical guidance.</p>
		<p>These notes describe the current informational website and do not replace terms agreed directly for a business supply arrangement. Have applicable website terms reviewed before production use.</p>
		<a class="text-link" href="/#contact">Contact Dhanvin Pharmaceuticals <span aria-hidden="true">&rarr;</span></a>
	</main>
	<SiteFooter />
</SiteLayout>